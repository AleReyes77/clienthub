{
  "name": "@clienthub/api",
  "version": "0.1.0",
  "private": true,
  "description": "ClientHub REST API (Express + Prisma + PostgreSQL).",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1175.0",
    "@clienthub/shared": "0.1.0",
    "@node-rs/argon2": "2.2.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "bullmq": "6.7.8",
    "cookie-parser": "1.4.7",
    "express": "5.3.0",
    "express-rate-limit": "8.7.5",
    "file-type": "22.3.0",
    "helmet": "8.3.0",
    "ioredis": "6.0.0",
    "multer": "2.5.0",
    "nodemailer": "10.6.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "rate-limit-redis": "6.0.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/multer": "2.3.0",
    "@types/node": "24.19.2",
    "@types/nodemailer": "8.0.2",
    "@types/smtp-server": "3.5.13",
    "@types/supertest": "7.2.1",
    "prisma": "7.10.1",
    "smtp-server": "3.21.7",
    "supertest": "7.3.2",
    "tsup": "9.0.0",
    "tsx": "4.23.15",
    "vitest": "5.1.1"
  }
}
