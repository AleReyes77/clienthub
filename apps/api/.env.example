# Copy to .env and adjust. Never commit the real .env file.
NODE_ENV=development
PORT=4000

# Docker Compose database (see docker-compose.yml at the repo root)
DATABASE_URL=postgresql://clienthub:clienthub@localhost:5432/clienthub

# Separate database used only by integration tests (it is wiped on every run)
TEST_DATABASE_URL=postgresql://clienthub:clienthub@localhost:5432/clienthub_test

# Origin of the web app. State-changing requests from any other origin are rejected (CSRF protection).
# Also used to build the links in emails.
WEB_ORIGIN=http://localhost:3000

SESSION_TTL_DAYS=7
# Number of proxies in front of the API (the Next.js dev server counts as one)
TRUST_PROXY=1
LOG_LEVEL=info
RATE_LIMIT_AUTH_MAX=10

# ── Background jobs ─────────────────────────────────────────────────────
# With Redis, jobs run through BullMQ (persistent, retried) and rate limits are shared.
# Leave empty to run jobs in-process (fine for local development).
REDIS_URL=
# REDIS_URL=redis://localhost:6379

# ── Email ───────────────────────────────────────────────────────────────
# Leave empty to print emails (with their links) to the API log. Required in production.
SMTP_URL=
# SMTP_URL=smtp://localhost:1025   # Mailpit from docker-compose (UI: http://localhost:8025)
MAIL_FROM="ClientHub <no-reply@clienthub.local>"

# ── File storage ────────────────────────────────────────────────────────
# Without S3_BUCKET, files are stored on disk in UPLOAD_DIR.
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10
S3_BUCKET=
S3_REGION=us-east-1
# For S3-compatible services (Cloudflare R2, MinIO…):
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── Optional integration tests ──────────────────────────────────────────
# TEST_REDIS_URL=redis://localhost:6379
# TEST_S3_ENDPOINT=http://localhost:9090
