# Copy to .env and adjust. Never commit the real .env file.
NODE_ENV=development
PORT=4000

# Docker Compose database (see docker-compose.yml at the repo root)
DATABASE_URL=postgresql://clienthub:clienthub@localhost:5432/clienthub

# Separate database used only by integration tests (it is wiped on every run)
TEST_DATABASE_URL=postgresql://clienthub:clienthub@localhost:5432/clienthub_test

# Origin of the web app. State-changing requests from any other origin are rejected (CSRF protection).
WEB_ORIGIN=http://localhost:3000

SESSION_TTL_DAYS=7
# Number of proxies in front of the API (the Next.js dev server counts as one)
TRUST_PROXY=1
LOG_LEVEL=info
RATE_LIMIT_AUTH_MAX=10
